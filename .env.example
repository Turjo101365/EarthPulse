# =============================================================================
# EARTHPULSE 3D / NASA FIRMS GIS - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your keys

# Google Earth & Google Maps Platform API Key
GOOGLE_EARTH_API_KEY=your_google_earth_api_key_here

# Application Server Port (Host port mapping)
PORT=8050

# LangSmith LLM Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=EarthPulse3D

# OpenAI API Key (PulseAI Copilot chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# DOCKER STACK CONFIGURATION & PORTS
# =============================================================================
# Avoid conflicting with other active Docker projects
POSTGRES_PORT=5433
PGADMIN_PORT=5051
ADMINER_PORT=8083
PROMETHEUS_PORT=9095
GRAFANA_PORT=3005


# PostgreSQL Database Configuration
POSTGRES_USER=earthpulse
POSTGRES_PASSWORD=earthpulse
POSTGRES_DB=earthpulse
DATABASE_URL=postgresql://earthpulse:earthpulse@postgres:5432/earthpulse

# pgAdmin Web Interface Credentials
PGADMIN_EMAIL=admin@earthpulse.io
PGADMIN_PASSWORD=admin
