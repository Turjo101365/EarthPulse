# =============================================================================
# EARTHPULSE 3D / NASA FIRMS GIS - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your keys

# Google Earth & Google Maps Platform API Key
GOOGLE_EARTH_API_KEY=your_google_earth_api_key_here

# Server Port
PORT=8050

# LangSmith LLM Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=EarthPulse3D
